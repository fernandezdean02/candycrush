<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Card Scatter Slot Game</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg:#141414;
    --card-bg:#222;
    --card-color:#fff;
    --accent:#e50914;
    --font:"Helvetica Neue",Helvetica,Arial,sans-serif;
  }
  body{
    margin:0;
    background:var(--bg);
    color:#fff;
    font-family:var(--font);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    overflow:hidden;
  }
  .game{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:1rem;
  }
  .reels{
    display:flex;
    gap:0.5rem;
  }
  .reel{
    width:80px;
    height:120px;
    background:var(--card-bg);
    border-radius:8px;
    overflow:hidden;
    position:relative;
  }
  .symbols{
    position:absolute;
    top:0;
    width:100%;
  }
  .symbol{
    width:100%;
    height:120px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:2rem;
    user-select:none;
  }
  .spin-btn{
    width:48px;
    height:48px;
    background:none;
    border:none;
    cursor:pointer;
    filter:invert(1);
  }
  .spin-btn:hover{opacity:0.8;}
  @media (max-width:600px){
    .reel{width:60px;height:90px;}
    .symbol{font-size:1.5rem;}
    .spin-btn{width:40px;height:40px;}
  }
</style>
</head>
<body>
<div class="game">
  <div class="reels" id="reels">
    <div class="reel"><div class="symbols"></div></div>
    <div class="reel"><div class="symbols"></div></div>
    <div class="reel"><div class="symbols"></div></div>
  </div>
  <button class="spin-btn" id="spin">
    <!-- lightweight SVG arrow -->
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div id="msg"></div>
</div>

<script>
const symbols = ['♠','♥','♦','♣','🂠','🂡']; // six card faces
const reelElements = document.querySelectorAll('.reel .symbols');
const msg = document.getElementById('msg');
const spinBtn = document.getElementById('spin');
let spinning = false;

// Populate each reel with a long column of symbols for smooth scroll
function initReels(){
  reelElements.forEach(col=>{
    col.innerHTML = '';
    // repeat symbols to create a loopable column
    for(let i=0;i<30;i++){
      const s = document.createElement('div');
      s.className='symbol';
      s.textContent = symbols[i%symbols.length];
      col.appendChild(s);
    }
  });
}
initReels();

// Helper to get a random index
function randIndex(){return Math.floor(Math.random()*symbols.length);}

// Spin animation
function spin(){
  if(spinning) return;
  spinning = true;
  msg.textContent='';
  const duration = 1200; // ms total spin per reel
  reelElements.forEach((col,i)=>{
    const offset = randIndex()*120; // each symbol 120px tall
    col.style.transition = `transform ${duration+ i*200}ms cubic-bezier(0.33,1,0.68,1)`;
    col.style.transform = `translateY(-${offset}px)`;
  });
  // Reset after animation to keep loop seamless
  setTimeout(()=>{
    reelElements.forEach(col=>{col.style.transition='none';col.style.transform='translateY(0)';});
    const result = reelElements.map(col=>col.children[0].textContent);
    checkWin(result);
    spinning = false;
  },duration+400);
}

// Simple win check: all three symbols match
function checkWin(res){
  if(res[0]===res[1] && res[1]===res[2]){
    msg.textContent='🎉 Jackpot! All '+res[0]+'s!';
    msg.style.color='var(--accent)';
  }else{
    msg.textContent='Try again!';
    msg.style.color='#fff';
  }
}

spinBtn.addEventListener('click',spin);
</script>
</body>
</html>



